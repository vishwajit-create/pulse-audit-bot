# -------------------------------------------------------------
# Telegram Bot Configuration
# -------------------------------------------------------------
# 1. Talk to @BotFather on Telegram (https://t.me/BotFather)
# 2. Run /newbot and follow instructions to get your HTTP API token
# 3. Paste the token below:
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN_HERE

# (Optional) Comma-separated Telegram User IDs allowed to use the bot
# Leave empty to allow any admin who runs /start
ALLOWED_ADMIN_IDS=

# (Optional) Chat ID where alerts should be forwarded
ALERT_CHAT_ID=

# -------------------------------------------------------------
# Render Website Audit Logs Endpoint
# -------------------------------------------------------------
AUDIT_LOGS_URL=https://pulse-chat-x187.onrender.com/api/admin/audit-logs?key=a582bada4cc1da841b5a851cba3e1809

# Real-time polling frequency in seconds
POLL_INTERVAL_SECONDS=15

# -------------------------------------------------------------
# Threat Intelligence (Optional)
# -------------------------------------------------------------
# Get a free key at https://www.abuseipdb.com/ to check IP reputation
ABUSEIPDB_API_KEY=
