# -------------------------------------------------------------
# Telegram Bot Configuration
# -------------------------------------------------------------
# 1. Talk to @BotFather on Telegram (https://t.me/BotFather)
# 2. Run /newbot and follow instructions to get your HTTP API token
# 3. Paste the token below:
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN_HERE

# (Optional) Comma-separated Telegram User IDs allowed to use the bot
ALLOWED_ADMIN_IDS=

# (Optional) Chat ID where alerts should be forwarded
ALERT_CHAT_ID=

